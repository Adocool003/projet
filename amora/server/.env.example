# Copiez ce fichier en .env (ou définissez ces variables dans votre hébergeur)
NODE_ENV=production
PORT=4000
CLIENT_URL=https://www.votre-domaine.fr
JWT_SECRET=remplacez-par-une-longue-chaine-aleatoire
DB_FILE=./data/amora.db
UPLOAD_DIR=./uploads

# Stripe (laisser vide = mode démo, paiements simulés)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PLUS=price_...
STRIPE_PRICE_GOLD=price_...
STRIPE_PRICE_PLATINUM=price_...
# TVA calculée automatiquement selon le pays du client (Stripe Tax)
STRIPE_AUTOMATIC_TAX=true
