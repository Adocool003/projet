{
  "name": "amora-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API de l'application de rencontre Amora (France / UE)",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/index.js",
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch src/index.js",
    "seed": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/seed.js",
    "make-admin": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/make-admin.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie": "^0.7.2",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "socket.io": "^4.8.1",
    "stripe": "^17.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
